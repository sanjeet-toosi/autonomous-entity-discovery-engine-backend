# --- storage ---
DATABASE_URL=postgresql+asyncpg://sanjeet@/business_graph?host=/tmp
REDIS_URL=redis://127.0.0.1:6379/3
NEO4J_ENABLED=true
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# --- models: auto picks anthropic > openai > ollama; heuristic fallback always available ---
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
LLM_MAX_DAILY_SPEND_USD=25

# --- api ---
API_PORT=8010
API_KEY=
CORS_ORIGINS=["http://localhost:3000"]

# --- crawl governance ---
CRAWL_PER_DOMAIN_RPM=12
CRAWL_GLOBAL_CONCURRENCY=32
CRAWL_MAX_PAGES_PER_DOMAIN=4
WORKER_CONCURRENCY=4
